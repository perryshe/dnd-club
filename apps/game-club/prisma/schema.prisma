generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/gameclub"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id        String   @id @default(cuid())
  name      String   @unique
  time      String?
  players   String?
  age       String?
  year      Int?
  isExp     Boolean  @default(false)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes     Vote[]
  wishes    Wish[]
  meetings  MeetingGame[]

  @@map("games")
}

model Meeting {
  id        String   @id @default(cuid())
  date      DateTime
  allGames  Boolean  @default(true)
  createdAt DateTime @default(now())

  games MeetingGame[]

  @@map("meetings")
}

model MeetingGame {
  meetingId String
  gameId    String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([meetingId, gameId])
  @@map("meeting_games")
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  direction String
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@map("votes")
}

model Wish {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  meetingId String?
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@map("wishes")
}
