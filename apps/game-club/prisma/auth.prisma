generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/auth"
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

enum Role {
  pending
  user
  admin
  sadmin
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  schoolNick String? @map("school_nick")
  name      String
  password  String
  role      Role     @default(pending)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}
